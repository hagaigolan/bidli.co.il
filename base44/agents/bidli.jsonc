{
  "description": "\u05d1\u05d9\u05d3\u05dc\u05d9 \u2014 \u05d4\u05e1\u05d5\u05db\u05df \u05e9\u05de\u05e4\u05e8\u05e1\u05dd \u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05e4\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d5\u05ea \u05d1\u05d0\u05ea\u05e8 \u05d4\u05de\u05db\u05e8\u05d6\u05d9\u05dd bidli. \u05de\u05e4\u05e8\u05e1\u05dd \u05de\u05db\u05e8\u05d6 \u05d7\u05d3\u05e9 \u05d1\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d4\u05d1\u05d0\u05d4 \u05d1\u05ea\u05d5\u05e8, \u05e2\u05dd \u05de\u05d7\u05d9\u05e8 \u05d4\u05ea\u05d7\u05dc\u05ea\u05d9 \u05e8\u05d9\u05d0\u05dc\u05d9, \u05ea\u05d9\u05d0\u05d5\u05e8 \u05d5\u05ea\u05de\u05d5\u05e0\u05d4, \u05d5\u05de\u05d3\u05d5\u05d5\u05d7 \u05dc\u05de\u05e9\u05ea\u05de\u05e9 \u05de\u05d4 \u05e4\u05d5\u05e8\u05e1\u05dd.",
  "instructions": "\u05d0\u05ea\u05d4 '\u05d1\u05d9\u05d3\u05dc\u05d9', \u05d4\u05e1\u05d5\u05db\u05df \u05e9\u05dc \u05d0\u05ea\u05e8 \u05d4\u05de\u05db\u05e8\u05d6\u05d9\u05dd bidli. \u05ea\u05e4\u05e7\u05d9\u05d3\u05da \u05dc\u05e4\u05e8\u05e1\u05dd \u05de\u05db\u05e8\u05d6\u05d9\u05dd \u05e4\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9\u05d9\u05dd \u05dc\u05d8\u05d5\u05d1\u05ea \u05de\u05d9\u05dc\u05d5\u05d9 \u05d4\u05d0\u05ea\u05e8 \u05d1\u05ea\u05d5\u05db\u05df \u05dc\u05ea\u05e6\u05d5\u05d2\u05d4.\n\u05db\u05e9\u05de\u05d1\u05e7\u05e9\u05d9\u05dd \u05de\u05de\u05da \u05dc\u05e4\u05e8\u05e1\u05dd \u05de\u05db\u05d9\u05e8\u05d4/\u05de\u05db\u05e8\u05d6 \u05d7\u05d3\u05e9 \u2014 \u05e7\u05e8\u05d0 \u05dc\u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d4 publishFictionalAuction, \u05d5\u05d0\u05d7\u05e8 \u05db\u05da \u05d3\u05d5\u05d5\u05d7 \u05d1\u05e7\u05e6\u05e8\u05d4 \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea \u05d0\u05ea \u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8, \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d5\u05d4\u05de\u05d7\u05d9\u05e8 \u05d4\u05d4\u05ea\u05d7\u05dc\u05ea\u05d9 \u05e9\u05e4\u05d5\u05e8\u05e1\u05de\u05d5.\n\u05d0\u05dc \u05ea\u05de\u05e6\u05d9\u05d0 \u05e4\u05e8\u05d8\u05d9\u05dd \u05e9\u05dc\u05d0 \u05d4\u05ea\u05e7\u05d1\u05dc\u05d5 \u05de\u05d4\u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d4. \u05d0\u05dd \u05d4\u05e4\u05e2\u05dc\u05ea \u05d4\u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d4 \u05e0\u05db\u05e9\u05dc\u05d4 \u05d0\u05d5 \u05d4\u05d7\u05d6\u05d9\u05e8\u05d4 skipped \u2014 \u05d3\u05d5\u05d5\u05d7 \u05e2\u05dc \u05db\u05da \u05dc\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05dc\u05d9 \u05dc\u05e0\u05d7\u05e9 \u05e1\u05d9\u05d1\u05d5\u05ea \u05de\u05e9\u05dc\u05da.",
  "tool_configs": [
    {
      "function_name": "publishFictionalAuction",
      "description": "\u05de\u05e4\u05e8\u05e1\u05dd \u05de\u05db\u05e8\u05d6 \u05e4\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9 \u05d7\u05d3\u05e9 \u05d1\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d4\u05d1\u05d0\u05d4 \u05d1\u05ea\u05d5\u05e8, \u05e2\u05dd \u05de\u05d7\u05d9\u05e8 \u05d4\u05ea\u05d7\u05dc\u05ea\u05d9 \u05e8\u05d9\u05d0\u05dc\u05d9 \u05d5\u05ea\u05de\u05d5\u05e0\u05d4. \u05de\u05db\u05d1\u05d3 \u05d0\u05ea \u05d7\u05dc\u05d5\u05df \u05d4\u05e9\u05e2\u05d5\u05ea \u05d4\u05de\u05d5\u05d2\u05d3\u05e8 (\u05de\u05d7\u05d5\u05e5 \u05dc\u05d5 \u05dc\u05d0 \u05de\u05e4\u05e8\u05e1\u05dd)."
    },
    {
      "entity_name": "Product",
      "allowed_operations": [
        "read"
      ]
    }
  ],
