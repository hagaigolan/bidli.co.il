{
  "type": "object",
  "name": "AppNotification",
  "properties": {
    "recipient_email": {
      "type": "string",
      "description": "\u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05d0\u05dc\u05d9\u05d5 \u05de\u05e9\u05d5\u05d9\u05db\u05ea \u05d4\u05d4\u05ea\u05e8\u05d0\u05d4 (\u05de\u05d6\u05d4\u05d4 \u05d4\u05e0\u05de\u05e2\u05df)"
    },
    "recipient_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "outbid",
        "won",
        "sold",
        "cancelled",
        "extension",
        "social",
        "new_match"
      ],
      "default": "outbid",
      "description": "social = \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea: \u05e2\u05e7\u05d9\u05d1\u05d4, \u05dc\u05d9\u05d9\u05e7 \u05d0\u05d5 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05e2\u05dc \u05d4\u05d0\u05d5\u05e1\u05e3. new_match = \u05de\u05db\u05e8\u05d6 \u05d7\u05d3\u05e9 \u05ea\u05d5\u05d0\u05dd \u05dc\u05d7\u05d9\u05e4\u05d5\u05e9 \u05e9\u05de\u05d5\u05e8"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_title": {
      "type": "string"
    },
    "product_image_url": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "recipient_email",
    "type",
    "title"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}