{
  "type": "object",
  "name": "AuctionReport",
  "properties": {
    "auctionId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05db\u05e8\u05d6 \u05e9\u05e2\u05dc\u05d9\u05d5 \u05d3\u05d5\u05d5\u05d7"
    },
    "auctionTitle": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05db\u05e8\u05d6 \u05d1\u05d6\u05de\u05df \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 \u2014 \u05dc\u05ea\u05e6\u05d5\u05d2\u05d4 \u05d1\u05e0\u05d9\u05d4\u05d5\u05dc"
    },
    "reporterId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05de\u05d3\u05d5\u05d5\u05d7 \u2014 \u05e8\u05d9\u05e7 \u05d0\u05dd \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 \u05e0\u05e9\u05dc\u05d7 \u05dc\u05dc\u05d0 \u05d4\u05ea\u05d7\u05d1\u05e8\u05d5\u05ea"
    },
    "reason": {
      "type": "string",
      "enum": [
        "\u05d7\u05e9\u05d5\u05d3",
        "\u05de\u05d6\u05d5\u05d9\u05e3",
        "\u05ea\u05d5\u05db\u05df \u05e4\u05d5\u05d2\u05e2\u05e0\u05d9",
        "\u05d0\u05d7\u05e8"
      ],
      "description": "\u05e1\u05d9\u05d1\u05ea \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7"
    },
    "details": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d7\u05d5\u05e4\u05e9\u05d9 \u05e9\u05dc \u05d4\u05de\u05d3\u05d5\u05d5\u05d7"
    },
    "createdDate": {
      "type": "string",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05e9\u05dc\u05d9\u05d7\u05ea \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7 (ISO)"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "handled"
      ],
      "default": "new"
    }
  },
  "required": [
    "auctionId",
    "reason"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}