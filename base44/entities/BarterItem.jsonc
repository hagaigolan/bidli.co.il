{
  "type": "object",
  "name": "BarterItem",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "category": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "\u05d7\u05d3\u05e9",
        "\u05de\u05e9\u05d5\u05de\u05e9",
        "\u05ea\u05e7\u05d9\u05df",
        "\u05de\u05e7\u05d5\u05dc\u05e7\u05dc"
      ]
    },
    "estimated_value": {
      "type": "number",
      "description": "\u05e9\u05d5\u05d5\u05d9 \u05de\u05d5\u05e2\u05e8\u05da \u05d1\u05e9\u05e7\u05dc\u05d9\u05dd"
    },
    "image_url": {
      "type": "string"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wanted_description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u05de\u05d4 \u05d4\u05de\u05e4\u05e8\u05e1\u05dd \u05de\u05d7\u05e4\u05e9 \u05d1\u05ea\u05de\u05d5\u05e8\u05d4"
    },
    "wanted_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05de\u05d5\u05e6\u05e8\u05d9\u05dd \u05e8\u05e6\u05d5\u05d9\u05d5\u05ea \u05d1\u05ea\u05de\u05d5\u05e8\u05d4"
    },
    "wanted_condition": {
      "type": "string",
      "enum": [
        "\u05d7\u05d3\u05e9",
        "\u05de\u05e9\u05d5\u05de\u05e9",
        "\u05ea\u05e7\u05d9\u05df",
        "\u05de\u05e7\u05d5\u05dc\u05e7\u05dc"
      ],
      "description": "\u05de\u05e6\u05d1 \u05d4\u05de\u05d5\u05e6\u05e8 \u05d4\u05e8\u05e6\u05d5\u05d9 \u05d1\u05ea\u05de\u05d5\u05e8\u05d4"
    },
    "allow_cash_topup": {
      "type": "boolean",
      "default": false,
      "description": "\u05de\u05e1\u05db\u05d9\u05dd \u05dc\u05ea\u05d5\u05e1\u05e4\u05ea \u05db\u05e1\u05e4\u05d9\u05ea \u05de\u05d4\u05e6\u05d3 \u05d4\u05e9\u05e0\u05d9"
    },
    "open_to_other": {
      "type": "boolean",
      "default": true,
      "description": "\u05e4\u05ea\u05d5\u05d7 \u05dc\u05d4\u05e6\u05e2\u05d5\u05ea \u05d1\u05d0\u05e8\u05d8\u05e8 \u05d0\u05d7\u05e8\u05d5\u05ea \u05e9\u05dc\u05d0 \u05e6\u05d5\u05d9\u05e0\u05d5"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "\u05e8\u05d2\u05d9\u05dc",
        "\u05d3\u05d7\u05d5\u05e3"
      ],
      "default": "\u05e8\u05d2\u05d9\u05dc"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "owner_phone": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "cancelled"
      ],
      "default": "active"
    }
  },
  "required": [
    "title",
    "condition",
    "owner_email",
    "wanted_description"
  ],
  "rls": {
    "read": null,
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}