{
  "type": "object",
  "name": "Commission",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_title": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_email": {
      "type": "string"
    },
    "final_sale_price": {
      "type": "number"
    },
    "commission_rate": {
      "type": "number"
    },
    "commission_amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid"
      ],
      "default": "pending"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "product_id",
    "final_sale_price",
    "commission_amount"
  ]
}