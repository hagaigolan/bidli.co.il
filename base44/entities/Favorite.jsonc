{
  "type": "object",
  "name": "Favorite",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_title": {
      "type": "string"
    },
    "product_image_url": {
      "type": "string"
    },
    "product_ends_at": {
      "type": "string"
    },
    "owner_key": {
      "type": "string"
    },
    "notify_email": {
      "type": "string"
    },
    "notify_phone": {
      "type": "string"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "product_id",
    "owner_key"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.owner_key": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_key": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_key": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}