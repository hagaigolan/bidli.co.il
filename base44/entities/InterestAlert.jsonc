{
  "type": "object",
  "name": "InterestAlert",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05d0\u05e1\u05e4\u05df \u05e9\u05d9\u05e7\u05d1\u05dc \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05e2\u05dc \u05de\u05db\u05e8\u05d6\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd"
    },
    "owner_name": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05d1\u05de\u05e2\u05e7\u05d1 \u2014 \u05d4\u05ea\u05e8\u05d0\u05d4 \u05e2\u05dc \u05db\u05dc \u05de\u05db\u05e8\u05d6 \u05d7\u05d3\u05e9 \u05d1\u05d0\u05d7\u05ea \u05de\u05d4\u05df"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e9\u05de\u05d5\u05ea \u05de\u05d5\u05e6\u05e8\u05d9\u05dd/\u05de\u05d9\u05dc\u05d5\u05ea \u05de\u05e4\u05ea\u05d7 \u05d1\u05de\u05e2\u05e7\u05d1 \u2014 \u05d4\u05ea\u05e8\u05d0\u05d4 \u05db\u05e9\u05db\u05d5\u05ea\u05e8\u05ea \u05de\u05db\u05e8\u05d6 \u05d7\u05d3\u05e9 \u05de\u05db\u05d9\u05dc\u05d4 \u05d0\u05d5\u05ea\u05dd"
    },
    "notify_email": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05e9\u05dc\u05d5\u05d7 \u05d2\u05dd \u05de\u05d9\u05d9\u05dc \u05de\u05e2\u05d5\u05e6\u05d1 \u05d1\u05e0\u05d5\u05e1\u05e3 \u05dc\u05d4\u05ea\u05e8\u05d0\u05d4 \u05d1\u05d0\u05ea\u05e8"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e2\u05e7\u05d1 \u05e4\u05e2\u05d9\u05dc"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "owner_email"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}