{
  "name": "LastMinuteBooking",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05db\u05e8\u05d6 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05e9\u05d9\u05d9\u05db\u05ea \u05d4\u05e8\u05e9\u05d5\u05de\u05d4"
    },
    "deal_title": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u2014 \u05e0\u05d7\u05e9\u05e4\u05ea \u05e8\u05e7 \u05dc\u05d1\u05e2\u05dc \u05d4\u05e2\u05e1\u05e7 \u05d5\u05dc\u05e7\u05d5\u05e0\u05d4"
    },
    "business_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d4\u05e2\u05e1\u05e7 \u2014 \u05e0\u05d7\u05e9\u05e3 \u05e8\u05e7 \u05dc\u05d1\u05e2\u05dc \u05d4\u05e2\u05e1\u05e7 \u05d5\u05dc\u05e7\u05d5\u05e0\u05d4"
    },
    "slot_start": {
      "type": "string"
    },
    "buyer_user_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_email": {
      "type": "string"
    },
    "buyer_phone": {
      "type": "string"
    },
    "sold_price": {
      "type": "number"
    },
    "platform_fee": {
      "type": "number",
      "description": "\u05e2\u05de\u05dc\u05ea \u05d4\u05d4\u05e6\u05dc\u05d4 \u05e9\u05d7\u05d5\u05e9\u05d1\u05d4 \u05e2\u05dc \u05d4\u05e2\u05e1\u05e7\u05d4"
    },
    "business_payout": {
      "type": "number",
      "description": "\u05d4\u05e1\u05db\u05d5\u05dd \u05e9\u05e2\u05d5\u05d1\u05e8 \u05dc\u05e2\u05e1\u05e7 \u05dc\u05d0\u05d7\u05e8 \u05e0\u05d9\u05db\u05d5\u05d9 \u05d4\u05e2\u05de\u05dc\u05d4"
    }
  },
  "required": [
    "deal_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.buyer_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}