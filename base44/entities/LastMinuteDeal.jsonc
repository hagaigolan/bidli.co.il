{
  "name": "LastMinuteDeal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea \u05e9\u05d4\u05ea\u05e4\u05e0\u05d4 \u2014 \u05dc\u05de\u05e9\u05dc '\u05ea\u05e1\u05e4\u05d5\u05e8\u05ea \u05d2\u05d1\u05e8\u05d9\u05dd + \u05e2\u05d9\u05e6\u05d5\u05d1 \u05d6\u05e7\u05df'"
    },
    "business_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e2\u05e1\u05e7 \u05e9\u05de\u05e4\u05e8\u05e1\u05dd \u05d0\u05ea \u05d4\u05d7\u05dc\u05d5\u05df \u05d4\u05e4\u05e0\u05d5\u05d9"
    },
    "business_type": {
      "type": "string",
      "enum": [
        "\u05d0\u05d5\u05dc\u05e4\u05df \u05d4\u05e7\u05dc\u05d8\u05d5\u05ea",
        "\u05de\u05e1\u05e4\u05e8\u05d4 / \u05e1\u05e4\u05e8",
        "\u05e7\u05dc\u05d9\u05e0\u05d9\u05e7\u05d4 \u05d5\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9\u05dd",
        "\u05e7\u05d5\u05e1\u05de\u05d8\u05d9\u05e7\u05d4 \u05d5\u05e6\u05d9\u05e4\u05d5\u05e8\u05e0\u05d9\u05d9\u05dd",
        "\u05e6\u05d9\u05dc\u05d5\u05dd",
        "\u05db\u05d5\u05e9\u05e8 \u05d5\u05d0\u05d9\u05de\u05d5\u05df \u05d0\u05d9\u05e9\u05d9",
        "\u05e9\u05d9\u05e2\u05d5\u05e8\u05d9\u05dd \u05e4\u05e8\u05d8\u05d9\u05d9\u05dd",
        "\u05d0\u05d7\u05e8"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea \u2014 \u05de\u05e9\u05de\u05e9 \u05dc\u05e1\u05d9\u05e0\u05d5\u05df \u05d5\u05dc\u05e1\u05d8\u05d8\u05d9\u05e1\u05d8\u05d9\u05e7\u05d5\u05ea"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "\u05de\u05d4 \u05db\u05dc\u05d5\u05dc \u05d1\u05e9\u05d9\u05e8\u05d5\u05ea \u2014 \u05d8\u05e7\u05e1\u05d8 \u05e9\u05d9\u05d5\u05d5\u05e7\u05d9 \u05d2\u05dc\u05d5\u05d9 \u05dc\u05db\u05d5\u05dc\u05dd"
    },
    "city": {
      "type": "string"
    },
    "slot_start": {
      "type": "string",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea \u05e9\u05d4\u05ea\u05e4\u05e0\u05d4 (ISO) \u2014 \u05d4\u05d7\u05dc\u05d5\u05df \u05d4\u05de\u05d1\u05d5\u05e7\u05e9"
    },
    "duration_minutes": {
      "type": "number",
      "default": 60,
      "description": "\u05de\u05e9\u05da \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea \u05d1\u05d3\u05e7\u05d5\u05ea"
    },
    "auction_starts_at": {
      "type": "string",
      "description": "\u05de\u05ea\u05d9 \u05e0\u05e4\u05ea\u05d7 \u05d4\u05de\u05db\u05e8\u05d6 \u05d4\u05d4\u05e4\u05d5\u05da (ISO)"
    },
    "auction_ends_at": {
      "type": "string",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05de\u05db\u05e8\u05d6 \u05d4\u05d4\u05e4\u05d5\u05da \u05e0\u05e1\u05d2\u05e8 (ISO) \u2014 \u05ea\u05de\u05d9\u05d3 \u05dc\u05e4\u05e0\u05d9 \u05de\u05d5\u05e2\u05d3 \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea"
    },
    "list_price": {
      "type": "number",
      "description": "\u05d4\u05de\u05d7\u05d9\u05e8 \u05d4\u05e8\u05d2\u05d9\u05dc \u05e9\u05dc \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea \u2014 \u05e0\u05e7\u05d5\u05d3\u05ea \u05d4\u05e4\u05ea\u05d9\u05d7\u05d4 \u05e9\u05dc \u05d4\u05de\u05db\u05e8\u05d6 \u05d4\u05d9\u05d5\u05e8\u05d3"
    },
    "floor_price": {
      "type": "number",
      "description": "\u05e8\u05e6\u05e4\u05ea \u05d4\u05de\u05d7\u05d9\u05e8 \u2014 \u05d4\u05e1\u05db\u05d5\u05dd \u05d4\u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05e9\u05d4\u05e2\u05e1\u05e7 \u05de\u05d5\u05db\u05df \u05dc\u05e7\u05d1\u05dc"
    },
    "fee_rate": {
      "type": "number",
      "default": 12,
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05e2\u05de\u05dc\u05ea \u05d4\u05d4\u05e6\u05dc\u05d4 \u05e9\u05e0\u05d2\u05d1\u05d9\u05ea \u05de\u05d4\u05e2\u05e1\u05e7\u05d4 \u05e9\u05e0\u05e1\u05d2\u05e8\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "sold",
        "expired",
        "cancelled"
      ],
      "default": "active"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "\u05de\u05db\u05e8\u05d6 \u05d4\u05d3\u05d2\u05de\u05d4 \u2014 \u05de\u05d5\u05e6\u05d2 \u05e2\u05dd \u05e1\u05d9\u05de\u05d5\u05df '\u05e4\u05e8\u05e1\u05d5\u05de\u05ea \u05dc\u05d3\u05d5\u05d2\u05de\u05d4' \u05d1\u05d3\u05e3 \u05d5\u05d1\u05db\u05e8\u05d8\u05d9\u05e1"
    },
    "buyer_user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e7\u05d5\u05e0\u05d4 \u2014 \u05dc\u05d0 \u05e0\u05d7\u05e9\u05e3 \u05de\u05de\u05e0\u05d5 \u05de\u05d9\u05d3\u05e2 \u05d0\u05d9\u05e9\u05d9; \u05de\u05e9\u05de\u05e9 \u05e8\u05e7 \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9 '\u05d4\u05d7\u05dc\u05d5\u05df \u05e9\u05dc\u05d9'"
    },
    "sold_price": {
      "type": "number",
      "description": "\u05d4\u05de\u05d7\u05d9\u05e8 \u05e9\u05d1\u05d5 \u05e0\u05dc\u05d7\u05e5 '\u05e7\u05e0\u05d4 \u05e2\u05db\u05e9\u05d9\u05d5' \u2014 \u05e0\u05e7\u05d1\u05e2 \u05d1\u05e9\u05e8\u05ea"
    },
    "sold_at": {
      "type": "string"
    },
    "cancelled_at": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "business_name",
    "slot_start",
    "auction_ends_at",
    "list_price",
    "floor_price"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}