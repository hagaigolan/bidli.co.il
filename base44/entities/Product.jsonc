{
  "type": "object",
  "name": "Product",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "subcategory": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "\u05d7\u05d3\u05e9",
        "\u05de\u05e6\u05d1 \u05de\u05e2\u05d5\u05dc\u05d4",
        "\u05de\u05e6\u05d1 \u05d8\u05d5\u05d1",
        "\u05de\u05e6\u05d1 \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9",
        "\u05dc\u05d0 \u05ea\u05e7\u05d9\u05df"
      ]
    },
    "is_stock": {
      "type": "boolean",
      "default": false
    },
    "starting_price": {
      "type": "number"
    },
    "buy_now_price": {
      "type": "number"
    },
    "current_price": {
      "type": "number"
    },
    "highest_bidder": {
      "type": "string"
    },
    "highest_bidder_email": {
      "type": "string"
    },
    "second_bidder_name": {
      "type": "string"
    },
    "second_bidder_email": {
      "type": "string"
    },
    "second_bid_amount": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seller_name": {
      "type": "string"
    },
    "seller_email": {
      "type": "string"
    },
    "seller_phone": {
      "type": "string"
    },
    "seller_user_id": {
      "type": "string"
    },
    "seller_photo_url": {
      "type": "string"
    },
    "seller_payment_method": {
      "type": "string",
      "enum": [
        "kashcash",
        "bit",
        "bank"
      ]
    },
    "seller_payme_phone": {
      "type": "string"
    },
    "seller_bank_details": {
      "type": "string"
    },
    "transfer_reported_at": {
      "type": "string"
    },
    "transfer_reference": {
      "type": "string"
    },
    "seller_confirmed_at": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "ends_at": {
      "type": "string"
    },
    "payment_deadline": {
      "type": "string"
    },
    "second_bidder_deadline": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ended",
        "awaiting_payment",
        "transfer_reported",
        "paid",
        "escrow",
        "delivered",
        "released",
        "disputed",
        "cancelled"
      ],
      "default": "active"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "frozen",
        "released",
        "refunded"
      ],
      "default": "unpaid"
    },
    "bid_count": {
      "type": "number",
      "default": 0
    },
    "snipe_extended": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05db\u05d1\u05e8 \u05e0\u05d5\u05e6\u05dc\u05d4 \u05d4\u05d0\u05e8\u05db\u05ea \u05d6\u05de\u05df \u05d4\u05d7\u05d3-\u05e4\u05e2\u05de\u05d9\u05ea \u05e9\u05dc 60 \u05e9\u05e0\u05d9\u05d5\u05ea"
    },
    "commission_rate": {
      "type": "number",
      "default": 0
    },
    "commission_amount": {
      "type": "number"
    },
    "commission_paid": {
      "type": "boolean",
      "default": false
    },
    "escrow_amount": {
      "type": "number"
    },
    "shipped_at": {
      "type": "string"
    },
    "delivered_at": {
      "type": "string"
    },
    "dispute_reason": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_payment_intent_client_secret": {
      "type": "string"
    },
    "card_registered": {
      "type": "boolean",
      "default": false
    },
    "payment_error": {
      "type": "string"
    },
    "installments_count": {
      "type": "number",
      "description": "\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd \u2014 \u05de\u05e1\u05e4\u05e8 \u05d4\u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd (2-4) \u05e9\u05d1\u05d7\u05e8 \u05d4\u05e7\u05d5\u05e0\u05d4; \u05dc\u05dc\u05d0 \u05d4\u05d2\u05d3\u05e8\u05d4 = \u05ea\u05e9\u05dc\u05d5\u05dd \u05d1\u05d5\u05d3\u05d3"
    },
    "installments_paid": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd \u05e9\u05d3\u05d5\u05d5\u05d7\u05d5 \u05e2\u05d3 \u05db\u05d4 \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05ea\u05e9\u05dc\u05d5\u05de\u05d9\u05dd"
    }
  },
  "required": [
    "title",
    "starting_price",
    "ends_at"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}