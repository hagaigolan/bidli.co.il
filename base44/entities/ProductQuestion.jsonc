{
  "type": "object",
  "name": "ProductQuestion",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_title": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "asker_name": {
      "type": "string"
    },
    "asker_contact": {
      "type": "string"
    },
    "seller_email": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "seller_user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "handled"
      ],
      "default": "open"
    },
    "handled_at": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "question",
    "seller_email"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "data.seller_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "data.seller_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "data.seller_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}