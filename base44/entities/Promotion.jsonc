{
  "type": "object",
  "name": "Promotion",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_title": {
      "type": "string"
    },
    "seller_email": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "package_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d7\u05d1\u05d9\u05dc\u05d4 \u05e9\u05e0\u05d1\u05d7\u05e8\u05d4 \u2014 \u05d1\u05d5\u05dc\u05d8 \u05d1\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 / \u05d3\u05e3 \u05d4\u05d1\u05d9\u05ea / \u05e4\u05e8\u05d9\u05de\u05d9\u05d5\u05dd"
    },
    "price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05d4\u05d7\u05d1\u05d9\u05dc\u05d4 \u05d1\u05e9\u05e7\u05dc\u05d9\u05dd \u2014 \u05d4\u05d7\u05d9\u05d5\u05d1 \u05de\u05ea\u05d1\u05e6\u05e2 \u05dc\u05d0\u05d7\u05e8 \u05d0\u05d9\u05e9\u05d5\u05e8"
    },
    "days": {
      "type": "number",
      "default": 7,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d9\u05de\u05d9\u05dd \u05e9\u05d4\u05de\u05db\u05e8\u05d6 \u05d9\u05d5\u05e6\u05d2 \u05db\u05de\u05e7\u05d5\u05d3\u05dd"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    },
    "reviewed_at": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "package_name"
  ],
  "rls": {
    "create": {
      "data.seller_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.seller_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}