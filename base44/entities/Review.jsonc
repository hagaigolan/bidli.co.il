{
  "type": "object",
  "name": "Review",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_title": {
      "type": "string"
    },
    "reviewee_email": {
      "type": "string",
      "description": "\u05d4\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05de\u05e7\u05d1\u05dc \u05d4\u05d3\u05d9\u05e8\u05d5\u05d2 (\u05d4\u05de\u05d5\u05db\u05e8 \u05d0\u05d5 \u05d4\u05e7\u05d5\u05e0\u05d4 \u05d1\u05e2\u05e1\u05e7\u05d4)"
    },
    "reviewee_name": {
      "type": "string"
    },
    "reviewee_role": {
      "type": "string",
      "enum": [
        "seller",
        "buyer"
      ],
      "default": "seller",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05de\u05e7\u05d1\u05dc \u05d4\u05d3\u05d9\u05e8\u05d5\u05d2 \u05d1\u05e2\u05e1\u05e7\u05d4 \u2014 \u05db\u05de\u05d5\u05db\u05e8 \u05d0\u05d5 \u05db\u05e7\u05d5\u05e0\u05d4"
    },
    "reviewer_role": {
      "type": "string",
      "enum": [
        "seller",
        "buyer"
      ],
      "default": "buyer",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05db\u05d5\u05ea\u05d1 \u05d4\u05d3\u05d9\u05e8\u05d5\u05d2 \u05d1\u05e2\u05e1\u05e7\u05d4 \u2014 \u05db\u05de\u05d5\u05db\u05e8 \u05d0\u05d5 \u05db\u05e7\u05d5\u05e0\u05d4"
    },
    "recommend": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05db\u05d5\u05ea\u05d1 \u05d4\u05d3\u05d9\u05e8\u05d5\u05d2 \u05de\u05de\u05dc\u05d9\u05e5 \u05e2\u05dc \u05d4\u05e6\u05d3 \u05d4\u05e9\u05e0\u05d9"
    },
    "seller_email": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_email": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "comment": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "seller_email",
    "rating"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.reviewer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.reviewer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}