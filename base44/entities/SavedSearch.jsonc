{
  "type": "object",
  "name": "SavedSearch",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d1\u05e2\u05dc \u05d4\u05d7\u05d9\u05e4\u05d5\u05e9 \u05d4\u05e9\u05de\u05d5\u05e8"
    },
    "owner_name": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d7\u05d9\u05e4\u05d5\u05e9 \u2014 \u05dc\u05de\u05e9\u05dc '\u05ea\u05db\u05e9\u05d9\u05d8\u05d9\u05dd \u05e2\u05d3 2,000\u20aa'"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u2014 \u05e8\u05d9\u05e7 = \u05db\u05dc \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea"
    },
    "max_price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05e4\u05ea\u05d9\u05d7\u05d4 \u05de\u05e7\u05e1\u05d9\u05de\u05dc\u05d9 \u2014 0 \u05d0\u05d5 \u05d4\u05d9\u05e2\u05d3\u05e8 = \u05dc\u05dc\u05d0 \u05d4\u05d2\u05d1\u05dc\u05d4"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "instant",
        "daily",
        "weekly"
      ],
      "default": "daily",
      "description": "\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u2014 instant = \u05db\u05dc \u05e9\u05e2\u05d4, daily = \u05d9\u05d5\u05de\u05d9, weekly = \u05e9\u05d1\u05d5\u05e2\u05d9"
    },
    "notify_email": {
      "type": "boolean",
      "default": true
    },
    "notify_phone": {
      "type": "string"
    },
    "last_scan_at": {
      "type": "string",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d4\u05e1\u05e8\u05d9\u05e7\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05df (ISO) \u2014 \u05de\u05db\u05e8\u05d6\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd \u05e9\u05e4\u05d5\u05e8\u05e1\u05de\u05d5 \u05de\u05d0\u05d6 \u05d9\u05d9\u05d1\u05d3\u05e7\u05d5 \u05d1\u05e1\u05e8\u05d9\u05e7\u05d4 \u05d4\u05d1\u05d0\u05d4"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "owner_email",
    "label"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}