{
  "type": "object",
  "name": "SiteStats",
  "properties": {
    "key": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u2014 'site_stats'"
    },
    "base_sales": {
      "type": "number",
      "description": "\u05d1\u05e1\u05d9\u05e1 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9 \u05dc\u05e1\u05da \u05d4\u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05e6\u05d8\u05d1\u05e8 (\u05d1\u05e9\u05e7\u05dc\u05d9\u05dd) \u2014 \u05db\u05dc \u05de\u05db\u05d9\u05e8\u05d4 \u05e9\u05de\u05e1\u05ea\u05d9\u05d9\u05de\u05ea \u05d0\u05d7\u05e8\u05d9 \u05de\u05d5\u05e2\u05d3 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05de\u05ea\u05d5\u05d5\u05e1\u05e4\u05ea \u05d0\u05dc\u05d9\u05d5"
    },
    "base_sales_at": {
      "type": "string",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05e7\u05d1\u05d9\u05e2\u05ea \u05d4\u05d1\u05e1\u05d9\u05e1 (ISO) \u2014 \u05e8\u05e7 \u05de\u05db\u05e8\u05d6\u05d9\u05dd \u05e9\u05d4\u05e1\u05ea\u05d9\u05d9\u05de\u05d5 \u05e2\u05dd \u05de\u05db\u05d9\u05e8\u05d4 \u05d0\u05d7\u05e8\u05d9\u05d5 \u05e0\u05e1\u05e4\u05e8\u05d9\u05dd \u05d5\u05de\u05ea\u05d5\u05d5\u05e1\u05e4\u05d9\u05dd"
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    }
  },
