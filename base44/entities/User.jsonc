{
  "type": "object",
  "name": "User",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "phone": {
      "type": "string",
      "description": "Phone number of the user"
    },
    "nickname": {
      "type": "string",
      "description": "Optional display nickname of the user"
    },
    "photo_url": {
      "type": "string",
      "description": "Profile photo of the user, displayed on their auction listings"
    },
    "seller_rating": {
      "type": "number"
    },
    "seller_review_count": {
      "type": "number",
      "default": 0
    },
    "seller_sales_count": {
      "type": "number",
      "default": 0
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "is_top_seller": {
      "type": "boolean",
      "default": false
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "none",
        "email",
        "phone",
        "id"
      ],
      "default": "none"
    },
    "trust_score": {
      "type": "number",
      "default": 100
    },
    "strikes": {
      "type": "number",
      "default": 0
    },
    "is_banned": {
      "type": "boolean",
      "default": false
    },
    "ban_reason": {
      "type": "string"
    },
    "cancelled_with_bids": {
      "type": "number",
      "default": 0,
      "description": "Internal counter of seller-cancelled auctions that had bids \u2014 used for the cancellation quota, not shown publicly"
    },
    "interest_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categories the user is interested in \u2014 used to offer personalized product recommendations in the profile"
    }
  },
  "required": [
    "role"
  ]
}