{
  "type": "object",
  "name": "User",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "phone": {
      "type": "string",
      "description": "Phone number of the user"
    },
    "nickname": {
      "type": "string",
      "description": "Optional display nickname of the user"
    },
    "photo_url": {
      "type": "string",
      "description": "Profile photo of the user, displayed on their auction listings"
    },
    "seller_rating": {
      "type": "number"
    },
    "seller_review_count": {
      "type": "number",
      "default": 0
    },
    "seller_sales_count": {
      "type": "number",
      "default": 0
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "is_top_seller": {
      "type": "boolean",
      "default": false
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "none",
        "email",
        "phone",
        "id"
      ],
      "default": "none"
    },
    "trust_score": {
      "type": "number",
      "default": 100
    },
    "strikes": {
      "type": "number",
      "default": 0
    },
    "is_banned": {
      "type": "boolean",
      "default": false
    },
    "ban_reason": {
      "type": "string"
    },
    "cancelled_with_bids": {
      "type": "number",
      "description": "Internal counter of seller-cancelled auctions that had bids \u2014 used for the cancellation quota, not shown publicly"
    },
    "interest_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categories the user is interested in \u2014 used to offer personalized product recommendations in the profile"
    },
    "last_login_at": {
      "type": "string",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d4\u05d4\u05ea\u05d7\u05d1\u05e8\u05d5\u05ea \u05d4\u05d0\u05d7\u05e8\u05d5\u05df \u05dc\u05d0\u05ea\u05e8 (ISO) \u2014 \u05e0\u05db\u05ea\u05d1 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05d1\u05db\u05e0\u05d9\u05e1\u05d4, \u05de\u05d5\u05e6\u05d2 \u05d1\u05e2\u05de\u05d5\u05d3 \u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd"
    },
    "referred_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05d4\u05d6\u05de\u05d9\u05df \u05d0\u05ea \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u2014 \u05e0\u05e9\u05de\u05e8 \u05de\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d4\u05d6\u05de\u05e0\u05d4 (?ref) \u05dc\u05e6\u05d5\u05e8\u05da \u05de\u05d3\u05d9\u05d3\u05ea \u05d4\u05e4\u05e6\u05d4 \u05d5\u05d9\u05e8\u05d0\u05dc\u05d9\u05ea"
    }
  },
  "required": [
    "role"
  ]
}