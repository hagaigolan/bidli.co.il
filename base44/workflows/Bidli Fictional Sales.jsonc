{
  "description": "\u05e4\u05e8\u05e1\u05d5\u05dd \u05de\u05db\u05e8\u05d6 \u05e4\u05d9\u05e7\u05d8\u05d9\u05d1\u05d9 \u05d7\u05d3\u05e9 \u05d1\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e9\u05d5\u05e0\u05d4 \u05de\u05d4\u05e7\u05d5\u05d3\u05dd, \u05db\u05dc 15 \u05d3\u05e7\u05d5\u05ea, \u05db\u05dc \u05d9\u05d5\u05dd \u05d1\u05d9\u05df 8:00 \u05dc-22:00 (\u05e9\u05e2\u05d5\u05df \u05d9\u05e9\u05e8\u05d0\u05dc) \u2014 \u05e2\u05d3 \u05d4\u05d5\u05d3\u05e2\u05d4 \u05dc\u05d4\u05e4\u05e1\u05e7\u05d4. \u05d4\u05e4\u05d5\u05e0\u05e7\u05e6\u05d9\u05d4 \u05d1\u05d5\u05d3\u05e7\u05ea \u05d0\u05ea \u05d7\u05dc\u05d5\u05df \u05d4\u05e9\u05e2\u05d5\u05ea \u05d5\u05dc\u05d0 \u05e2\u05d5\u05e9\u05d4 \u05db\u05dc\u05d5\u05dd \u05de\u05d7\u05d5\u05e5 \u05dc\u05d5.",
  "name": "Bidli Fictional Sales",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 8-22 * * *",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "bidli_fictional_sales",
