{
  "name": "Last Minute Demo Deals",
  "description": "\u05e4\u05e8\u05e1\u05d5\u05dd 5 \u05de\u05db\u05e8\u05d6\u05d9\u05dd \u05d4\u05e4\u05d5\u05db\u05d9\u05dd \u05dc\u05d3\u05d5\u05d2\u05de\u05d4 \u05d1\u05db\u05dc \u05d9\u05d5\u05dd \u05d1\u05e9\u05e2\u05d4 08:00 (\u05e9\u05e2\u05d5\u05df \u05d9\u05e9\u05e8\u05d0\u05dc) \u05d1\u05e2\u05de\u05d5\u05d3 '\u05d1\u05e8\u05d2\u05e2 \u05d4\u05d0\u05d7\u05e8\u05d5\u05df', \u05d5\u05e4\u05e8\u05e1\u05d5\u05dd \u05d0\u05d5\u05ea\u05dd \u05d7\u05dc\u05d5\u05e0\u05d5\u05ea \u05dc\u05d0\u05d9\u05e0\u05e1\u05d8\u05d2\u05e8\u05dd. \u05d4\u05de\u05db\u05e8\u05d6\u05d9\u05dd \u05de\u05e1\u05d5\u05de\u05e0\u05d9\u05dd \u05db'\u05e4\u05e8\u05e1\u05d5\u05de\u05ea \u05dc\u05d3\u05d5\u05d2\u05de\u05d4', \u05d0\u05d9\u05e0\u05dd \u05e0\u05d9\u05ea\u05e0\u05d9\u05dd \u05dc\u05e8\u05db\u05d9\u05e9\u05d4, \u05d5\u05de\u05ea\u05d7\u05dc\u05e4\u05d9\u05dd \u05d1\u05db\u05dc \u05d9\u05d5\u05dd.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "last_minute_demo_deals",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "publish_demo_deals": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "publishDemoLastMinute",
            "args": {}
          },
          "then": "share_demo_deals",
          "x-base44": {
            "title": "\u05e4\u05e8\u05e1\u05d5\u05dd 5 \u05de\u05db\u05e8\u05d6\u05d9 \u05d4\u05d3\u05d2\u05de\u05d4",
            "description": "\u05d7\u05dc\u05d5\u05e0\u05d5\u05ea \u05e9\u05d9\u05e8\u05d5\u05ea \u05d7\u05d3\u05e9\u05d9\u05dd \u05d1\u05e2\u05de\u05d5\u05d3 \u05d1\u05e8\u05d2\u05e2 \u05d4\u05d0\u05d7\u05e8\u05d5\u05df"
          }
        }
      },
      {
        "share_demo_deals": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "publishDemoDealSocial",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e4\u05e8\u05e1\u05d5\u05dd \u05dc\u05d0\u05d9\u05e0\u05e1\u05d8\u05d2\u05e8\u05dd",
            "description": "\u05e4\u05d5\u05e1\u05d8 \u05d0\u05d7\u05d3 \u05e2\u05dd \u05db\u05dc \u05d4\u05d7\u05dc\u05d5\u05e0\u05d5\u05ea \u05e9\u05dc \u05d4\u05d9\u05d5\u05dd"
          }
        }
      }
    ]
  }
}