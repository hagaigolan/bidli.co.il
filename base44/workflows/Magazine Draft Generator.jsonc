{
  "description": "\u05d8\u05d9\u05d5\u05d8\u05ea \u05de\u05d0\u05de\u05e8 \u05de\u05d2\u05d6\u05d9\u05df \u05d7\u05d3\u05e9\u05d4 \u05de\u05e1\u05d5\u05db\u05df \u05d4-AI \u2014 3 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 (\u05e8\u05d0\u05e9\u05d5\u05df, \u05e9\u05dc\u05d9\u05e9\u05d9 \u05d5\u05d7\u05de\u05d9\u05e9\u05d9 \u05d1-09:00, \u05e9\u05e2\u05d5\u05df \u05d9\u05e9\u05e8\u05d0\u05dc) \u05dc\u05d4\u05d0\u05e6\u05ea \u05ea\u05d5\u05db\u05df \u05d4-SEO. \u05d4\u05d8\u05d9\u05d5\u05d8\u05d4 \u05e0\u05e9\u05de\u05e8\u05ea \u05e2\u05dd \u05e1\u05d8\u05d8\u05d5\u05e1 '\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8' \u05d5\u05de\u05d9\u05d9\u05dc \u05e0\u05e9\u05dc\u05d7 \u05dc\u05d0\u05d3\u05de\u05d9\u05df. \u05e4\u05e8\u05e1\u05d5\u05dd \u05e8\u05e7 \u05dc\u05d0\u05d7\u05e8 \u05d0\u05d9\u05e9\u05d5\u05e8.",
  "name": "Magazine Draft Generator",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1,3,5",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "magazine_draft_generator",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
