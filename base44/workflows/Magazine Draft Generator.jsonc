          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateMagazineDrafts",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "\u05d9\u05e6\u05d9\u05e8\u05ea \u05d8\u05d9\u05d5\u05d8\u05ea \u05de\u05d0\u05de\u05e8",
            "description": "\u05de\u05d7\u05d9\u05e8\u05d5\u05df \u05d0\u05d5 \u05de\u05d3\u05e8\u05d9\u05da \u2014 \u05dc\u05e4\u05d9 \u05e1\u05d1\u05d1"
          }
        }
      }
    ]
  }
}