          "x-base44": {
            "title": "\u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05e4\u05e8\u05e1\u05d5\u05dd \u05de\u05d7\u05d3\u05e9",
            "description": "\u05de\u05db\u05e8\u05d6\u05d9\u05dd \u05e9\u05d4\u05e1\u05ea\u05d9\u05d9\u05de\u05d5 \u05dc\u05dc\u05d0 \u05de\u05db\u05d9\u05e8\u05d4 \u05dc\u05e4\u05e0\u05d9 5 \u05d9\u05de\u05d9\u05dd \u2014 \u05de\u05d9\u05d9\u05dc \u05e2\u05dd \u05db\u05e4\u05ea\u05d5\u05e8 \"\u05e4\u05e8\u05e1\u05dd \u05e9\u05d5\u05d1\""
          }
        }
      }
    ]
