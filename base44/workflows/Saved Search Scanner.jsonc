{
  "name": "Saved Search Scanner",
  "description": "Checks every hour for newly published auctions matching users' saved searches and notifies them by email and bell notification, according to each search's frequency.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": 1,
      "interval_unit": "hours",
      "interval_anchor": "2026-10-01T12:00:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "saved_search_scanner",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan_saved_searches": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scanSavedSearches",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e1\u05e8\u05d9\u05e7\u05ea \u05d7\u05d9\u05e4\u05d5\u05e9\u05d9\u05dd \u05e9\u05de\u05d5\u05e8\u05d9\u05dd",
            "description": "\u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05e2\u05dc \u05de\u05db\u05e8\u05d6\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd \u05d4\u05ea\u05d5\u05d0\u05de\u05d9\u05dd \u05dc\u05d7\u05d9\u05e4\u05d5\u05e9\u05d9\u05dd \u05d4\u05e9\u05de\u05d5\u05e8\u05d9\u05dd \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd"
          }
        }
      }
    ]
  }
}